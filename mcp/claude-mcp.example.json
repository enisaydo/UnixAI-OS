{
  "mcpServers": {
    "unixai-os": {
      "command": "python3",
      "args": ["/opt/unixai-os/mcp/unixai_mcp.py"],
      "env": {
        "UNIXAI_URL": "http://unixai.kurum.local:3000",
        "UNIXAI_API_TOKEN": "<UnixAI OS .env → UNIXAI_API_TOKEN>"
      }
    },
    "morpheusai": {
      "command": "node",
      "args": ["/opt/morpheus-ai/mcp/morpheus-mcp.js"],
      "env": {
        "MORPHEUS_URL": "http://morpheus.kurum.local:3000",
        "MORPHEUS_API_TOKEN": "<MorpheusAI .env → MORPHEUS_API_TOKEN>"
      }
    }
  }
}
