PORT=3000
# Dinlenecek adres (0.0.0.0 = tüm arayüzler)
HOST=0.0.0.0
HOST_PORT=3000

# ===================== GİRİŞ =====================
# LDAP tanımlı değilse yerel yönetici hesabı (install.sh rastgele parola üretir).
# UnixAI root SSH anahtarı kullandığı için ADMIN_PASSWORD veya LDAP_SERVER mutlaka tanımlı olmalı.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ===================== GenAI (GPT) =====================
# Token servisi ve chat/completions adresleri ARAYÜZDEN girilir: Ayarlar → GenAI bağlantısı
# (data/connection.json'a kaydedilir). İsterseniz ilk değerleri buradan da verebilirsiniz
# (MorpheusAI ile aynı biçim; arayüzden kaydedince arayüzdeki değerler geçerli olur):
#TMS_TOKEN_URL=
#TMS_BODY={"client_id":"","client_secret":"","grant_type":"password","username":"","password":""}
#TMS_H_GUID={{uuid}}
#TMS_H_CONTENT_TYPE=application/json
#CHAT_URL=
#CHAT_MODEL_FIELD=model_name
#CHAT_MODEL=gpt-5.5
#CHAT_BODY_EXTRA={"max_completion_tokens":16000}
#CHAT_H_CLIENT_ID=
#GENAI_TLS_INSECURE=true
#GENAI_TIMEOUT_MS=180000
#
# Sırları arayüze yazmak istemezseniz burada tutup arayüzde {{env:İSİM}} kullanın, ör.:
#   TMS_CLIENT_SECRET=...      → token gövdesinde  "client_secret":"{{env:TMS_CLIENT_SECRET}}"
#   TMS_PASSWORD=...           → "password":"{{env:TMS_PASSWORD}}"

# Token yanıt header'ında geliyorsa ("authorization: Bearer: <token>") arayüzde
# Ayarlar → GenAI bağlantısı → "Token nereden alınsın: Yanıt header'ı" seçin (veya:)
#TMS_TOKEN_SOURCE=header
#TMS_TOKEN_HEADER=authorization

# Aynı anda en fazla kaç sunucu GPT'ye gönderilsin
AI_CONCURRENCY=3

# Kurum içi CA (self-signed yerine): Python sistem CA deposunu kullanır →
#   cp kurum-ca.pem /etc/pki/ca-trust/source/anchors/ && update-ca-trust
# veya yalnızca bu uygulama için:
#SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt

# ===================== SERVİSLER ARASI / MCP =====================
# MCP sunucusu (mcp/unixai_mcp.py) ve otomasyonlar için: Authorization: Bearer <token>  (≥16 karakter; openssl rand -hex 24)
UNIXAI_API_TOKEN=
# MorpheusAI köprüsü (arayüzden de girilebilir: Ayarlar → MorpheusAI)
#MORPHEUS_URL=http://morpheus.kurum.local:3000
#MORPHEUS_API_TOKEN=

# ===================== SSH =====================
# Varsayılanlar (Ayarlar → SSH ekranından da değiştirilebilir)
SSH_USER=root
SSH_KEY_FILE=/root/.ssh/id_rsa

# ===================== LDAP GİRİŞİ (opsiyonel) =====================
# LDAP_SERVER doluysa yerel yönetici yerine LDAP ile giriş yapılır (MorpheusAI ile aynı):
#   LDAP_SERVER  : dc01.kurum.local:636
#   LDAP_BASE_DN : DC=kurum,DC=local
#   LDAP_BIND_DN : {{username}}@kurum.local
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_STARTTLS=false
LDAP_TLS_INSECURE=true
# Sadece bu grubun üyeleri girebilir / ayarları yalnızca bu grup değiştirebilir
LDAP_REQUIRED_GROUP=
LDAP_ADMIN_GROUP=
# Oturum süresi (saat); HTTPS arkasındaysa SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false

# ===================== TOKEN KULLANIMI / LOG =====================
# Günlük limitler arayüzden belirlenir. Gün sınırı ve zamanlayıcı saati bu saat dilimine göre:
USAGE_TIMEZONE=Europe/Istanbul
# Önde SSO yapan bir proxy varsa kullanıcı adını taşıyan header
USER_HEADER=
# Her işlem kategorisine göre AYRI dosyaya yazılır: logs/<kategori>/<kategori>-YYYY-MM-DD.jsonl
#   islem, giris, ssh, toplama, tani, genai, morpheus, mcp-istemci, mcp-sunucu, ajan, ajanlar-arasi  (gizli alanlar maskelenir)
LOG_DIR=
LOG_FILE=true
LOG_RETENTION_DAYS=90

# ===================== LANGFUSE (isteğe bağlı ajan izleme) =====================
# Kurulum: UnixAI-OS deposunda deploy/langfuse/kur.sh — sonda yazdırılan değerleri buraya girin. Boşsa izleme kapalı.
# Her ajan çalışması, araç adımı ve GPT çağrısı (model, token) OpenTelemetry ile gönderilir; iki ajanın konuşması tek iz olur.
LANGFUSE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=unixai-morpheus
# false: soru/cevap/argüman gönderilmez (yalnızca adlar, süreler, token sayıları)
LANGFUSE_CAPTURE_IO=true
LANGFUSE_TLS_INSECURE=false
LANGFUSE_ENVIRONMENT=production
